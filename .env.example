GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_compatible_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-20b
DATA_DIR=/app/data
PRESETS_DIR=/app/presets
LOGS_DIR=/app/logs

# Word scheduler: v1_legacy (circular queue) | v2_llm (LLM-based selection)
ALGO_VERSION=v1_legacy
# SCHEDULER_MODEL=llama-3.1-8b-instant
# SCHEDULER_TIMEOUT=8